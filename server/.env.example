# Billy Bass AI Server — Environment Variables
# Copy this file to .env and fill in your API keys.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API key (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs Voice ID (find at https://elevenlabs.io/app/voice-library)
ELEVENLABS_VOICE_ID=your_voice_id_here

# Picovoice Access Key (https://console.picovoice.ai/)
PICOVOICE_ACCESS_KEY=your_picovoice_key_here

# Optional: Path to custom Porcupine keyword (.ppn) file
# If empty, uses the built-in keyword specified below
# PORCUPINE_KEYWORD_PATH=/path/to/hey-vega.ppn

# Built-in keyword to use if no custom .ppn is provided
# Options: computer, jarvis, alexa, hey google, ok google, etc.
PORCUPINE_BUILTIN_KEYWORD=jarvis

# Optional: Override defaults
# GEMINI_MODEL=gemini-2.0-flash-live-preview
# ELEVENLABS_MODEL=eleven_flash_v2_5
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8765
# LOG_LEVEL=DEBUG
