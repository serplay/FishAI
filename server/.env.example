# Billy Bass AI Server — Environment Variables
# Copy this file to .env and fill in your values.

# ElevenLabs API key (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs Conversational AI Agent ID
# Create an agent at https://elevenlabs.io/app/conversational-ai
# Configure the agent's personality, voice, LLM, and system prompt there.
ELEVENLABS_AGENT_ID=your_agent_id_here

# Wake Word Configuration (openWakeWord — free, no API key needed)
# Comma-separated model names. Pre-trained options include:
#   hey_jarvis_v0.1, alexa_v0.1, hey_mycroft_v0.1
# Full list: https://github.com/dscripka/openWakeWord#pre-trained-models
OWW_MODEL_NAMES=hey_jarvis_v0.1

# Detection threshold (0.0 – 1.0). Higher = fewer false positives.
OWW_THRESHOLD=0.5

# Optional: Override defaults
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8765
# LOG_LEVEL=DEBUG
